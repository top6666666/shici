<view class="container">
  <view class="card hero">
    <view class="hero-title">🗺️ 路线探索</view>
    <view class="subtitle">打卡解锁诗旅路线 · 已解锁 {{totalUnlocked}} / {{total}}</view>
    <view class="bar"><view class="fill" style="width:{{percent}}%"></view></view>
    <view class="progress-text">路线解锁进度 {{percent}}%</view>
  </view>

  <view class="section-title">诗旅路线 · 打卡解锁</view>
  <view class="card route {{item.unlocked ? '' : 'locked'}}" wx:for="{{routes}}" wx:key="id" bindtap="open" data-id="{{item.id}}">
    <view class="r-top">
      <view class="tag">{{item.type}}</view>
      <view class="state {{item.unlocked ? 'open' : 'lock'}}">{{item.unlocked ? '已解锁 ✓' : '待解锁 🔒'}}</view>
    </view>
    <view class="route-name">{{item.name}}</view>
    <view class="subtitle">{{item.points}}</view>
    <view class="desc">{{item.desc}}</view>
    <view class="link">关联点位：{{item.ptsText}} · 已打卡 {{item.explored}}/{{item.total}}</view>
    <view class="bar small"><view class="fill" style="width:{{item.percent}}%"></view></view>
  </view>

  <view class="foot" bindtap="goStamp"><view class="btn">去打卡文化点位 🏮</view></view>
  <view class="foot-tip">每条路线关联若干文化点位，前往"首站打卡"盖印即可解锁对应路线。</view>
</view>
