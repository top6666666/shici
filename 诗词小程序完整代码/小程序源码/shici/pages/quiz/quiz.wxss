.container{min-height:100vh;background:#F7F1E3;padding:24rpx;box-sizing:border-box}
.card{background:#FFFDF8;border-radius:24rpx;padding:28rpx;margin-bottom:20rpx}
.hero-title{font-size:36rpx;font-weight:700;color:#3A2E28}
.subtitle{font-size:24rpx;color:#8A817A;margin-top:10rpx}
.bar{height:18rpx;background:#E9DED0;border-radius:999rpx;margin-top:24rpx;overflow:hidden}
.fill{height:100%;background:linear-gradient(90deg,#A65B4E,#8C2F39);border-radius:999rpx;transition:width .3s}
.progress-text{font-size:22rpx;color:#A65B4E;margin-top:14rpx}
.q-title{font-size:32rpx;font-weight:700;color:#3A2E28;line-height:1.6;margin-bottom:24rpx}
.opt{padding:26rpx;background:#F5EBDD;border-radius:18rpx;margin-bottom:18rpx;font-size:28rpx;color:#3A2E28;border:3rpx solid transparent}
.opt.right{background:#E7F2E9;color:#2F6B3F;border-color:#4A7C59}
.opt.wrong{background:#F8E3E3;color:#9C3A3A;border-color:#C05B5B}
.note{font-size:25rpx;color:#8A817A;background:#F7F1E3;padding:18rpx;border-radius:14rpx;margin-top:6rpx;line-height:1.6}
.btn{margin-top:24rpx;text-align:center;padding:24rpx;border-radius:999rpx;font-size:30rpx;font-weight:700}
.next{background:#8C2F39;color:#FFFDF8}
.result{text-align:center;padding:60rpx 30rpx}
.r-title{font-size:40rpx;font-weight:700;color:#3A2E28}
.r-score{font-size:56rpx;font-weight:700;color:#8C2F39;margin-top:24rpx}
.r-percent{font-size:28rpx;color:#A65B4E;margin-top:12rpx}
.r-tip{font-size:27rpx;color:#6B5F56;margin-top:30rpx;line-height:1.8;padding:0 20rpx}
