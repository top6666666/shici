 .route{display:flex;justify-content:space-between;align-items:center}.r-main{flex:1;margin-right:16rpx}.route-name{font-size:31rpx;font-weight:700;margin:14rpx 0}.points,.desc{font-size:23rpx;color:#777;line-height:1.7}.arrow{font-size:50rpx;color:#8C2F39}.pts-head{font-size:24rpx;color:#8C2F39;font-weight:700;margin-top:18rpx}.pts{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:12rpx}.pt{background:#F7F1E3;border-radius:12rpx;padding:10rpx 18rpx;display:flex;align-items:center;gap:8rpx;border:3rpx solid transparent}.pt.tappable{border-color:#C8A97E}.dot{font-size:20rpx;color:#C0B8AE}.dot.on{color:#2F6B3F}.pt-name{font-size:22rpx;color:#8A817A}.pt-name.stamped{color:#2F6B3F;font-weight:700}.go{text-align:center;color:#8C2F39;font-weight:700;font-size:26rpx;padding:8rpx 0}

.luoyang-entry{border:2rpx solid #b99060}.luoyang-entry .go{margin-top:22rpx;color:#782e39;font-size:28rpx;font-weight:600}
