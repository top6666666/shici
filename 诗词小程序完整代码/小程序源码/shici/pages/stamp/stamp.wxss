.container{min-height:100vh;background:#F7F1E3;padding:24rpx;box-sizing:border-box}
.card{background:#FFFDF8;border-radius:24rpx;padding:28rpx;margin-bottom:20rpx}
.hero-top{display:flex;justify-content:space-between;align-items:center}
.hero-title{font-size:36rpx;font-weight:700;color:#3A2E28}
.reset{font-size:24rpx;color:#8A817A;padding:10rpx 24rpx;background:#F0DFCA;border-radius:999rpx}
.subtitle{font-size:24rpx;color:#8A817A;margin-top:10rpx}
.bar{height:18rpx;background:#E9DED0;border-radius:999rpx;margin-top:24rpx;overflow:hidden}
.fill{height:100%;background:linear-gradient(90deg,#A65B4E,#8C2F39);border-radius:999rpx;transition:width .3s}
.progress-text{font-size:22rpx;color:#A65B4E;margin-top:14rpx}
.section-title{font-size:30rpx;font-weight:700;color:#3A2E28;margin:8rpx 4rpx 16rpx}
.point{display:flex;align-items:center;gap:20rpx}.point.focus{border:3rpx solid #8C2F39;box-shadow:0 0 0 6rpx rgba(140,47,57,.10)}
.p-main{flex:1}
.p-name{font-size:32rpx;font-weight:700;color:#3A2E28}
.city{font-size:22rpx;color:#8A817A;font-weight:400;margin-left:12rpx;background:#F0DFCA;padding:4rpx 14rpx;border-radius:999rpx}
.p-poem{font-size:26rpx;color:#8C2F39;margin-top:10rpx;font-weight:600}
.p-intro{font-size:23rpx;color:#8A817A;margin-top:8rpx;line-height:1.6}
.p-state{flex-shrink:0;padding:16rpx 30rpx;border-radius:999rpx;background:#8C2F39;color:#FFFDF8;font-size:26rpx;font-weight:700}
.p-state.done{background:#4A7C59;color:#FFFDF8}
.foot-tip{font-size:22rpx;color:#A79E94;text-align:center;padding:8rpx 20rpx 30rpx;line-height:1.7}
