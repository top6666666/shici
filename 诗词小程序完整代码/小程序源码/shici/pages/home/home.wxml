<view class="container">
  <view class="hero card">
    <view class="title">中原诗词 · 行走河南</view>
<view class="card" bindtap="goPoem"><view class="title">河南诗词200首</view><view class="subtitle">点击查看部分诗库</view></view>
    <view class="subtitle">让诗词活起来，让文化走出去</view>
    <view class="quote">“读诗词，游中原，见文脉，知家国。”</view>
    <view class="hero-actions">
      <view class="btn" bindtap="goMap">探索诗词地图</view>
      <view class="btn-light" bindtap="goRoutes">开始诗旅</view>
    </view>
  </view>

  <view class="section-title">今日诗词</view>
  <view class="poem card" bindtap="goPoem">
    <view class="poem-title">春望 · 杜甫</view>
    <view class="poem-text">国破山河在，城春草木深。</view>
    <view class="poem-note">诗人 · 巩义文化脉络 · 家国情怀</view>
  </view>

  <view class="section-title">核心功能</view>

  <view class="ai-banner" bindtap="goAiAsk">
    <view class="ai-banner-left">
      <view class="ai-banner-icon">🤖</view>
      <view class="ai-banner-text">
        <view class="ai-banner-title">AI 问诗助手</view>
        <view class="ai-banner-sub">诗句意思 · 诗人典故 · 河南诗旅，直接问</view>
      </view>
    </view>
    <view class="ai-banner-arrow">›</view>
  </view>

  <view class="grid">
    <view class="feature card" bindtap="goMap"><view class="icon">🗺️</view><view>诗词地图</view><text>诗人行迹 · 点位导航</text></view>
    <view class="feature card" bindtap="goAudio"><view class="icon">🎧</view><view>听诗唱诗</view><text>朗诵 · 方言唱诗</text></view>
    <view class="feature card" bindtap="goInteractive"><view class="icon">🎯</view><view>互动打卡</view><text>接龙 · 集章 · 解谜</text></view>
    <view class="feature card" bindtap="goStudy"><view class="icon">📚</view><view>诗词研学</view><text>任务卡 · 证书</text></view>
  </view>

  <view class="card" bindtap="goLuoyang"><view class="title">洛阳一日诗旅</view><view class="subtitle">按兴趣生成路线，每站都有诗词与来源</view><view class="btn-light" style="margin-top:20rpx">开始安排 ›</view></view>
  <view class="section-title">热门诗旅</view>
  <view class="route card" wx:for="{{routes}}" wx:key="id" bindtap="openRoute" data-id="{{item.id}}">
    <view><view class="route-name">{{item.name}}</view><view class="subtitle">{{item.desc}}</view></view>
    <view class="arrow"></view>
  </view>
</view>
