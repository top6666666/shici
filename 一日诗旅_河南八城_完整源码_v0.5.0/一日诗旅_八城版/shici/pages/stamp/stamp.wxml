<view class="container">
  <view class="card hero">
    <view class="hero-top">
      <view class="hero-title">🏮 首站打卡</view>
      <view class="hero-actions"><view class="reset" bindtap="reset">重置</view></view>
    </view>
    <view class="subtitle">点亮你的河南诗词足迹 · 已盖章 {{stampedCount}} / {{total}}</view>
    <view class="bar"><view class="fill" style="width:{{percent}}%"></view></view>
    <view class="progress-text">打卡进度 {{percent}}% · 集齐全部印章解锁诗旅达人</view>
  </view>

  <view class="section-title">文化点位 · 逐一打卡</view>
  <view class="card point {{focus === String(item.id) ? 'focus' : ''}}" wx:for="{{points}}" wx:key="id" id="pt-{{item.id}}" bindtap="stamp" data-id="{{item.id}}">
    <view class="p-main">
      <view class="p-name">{{item.name}}<text class="city">{{item.city}}</text></view>
      <view class="p-poem">{{item.poem}}</view>
      <view class="p-intro">{{item.intro}}</view>
    </view>
    <view class="p-state {{item.stamped ? 'done' : ''}}">{{item.stamped ? '已盖章 ✓' : '打卡'}}</view>
  </view>

  <view class="foot-tip">点击点位即可打卡盖印，印章会保存在本机，下次进入仍会保留。</view>
</view>
