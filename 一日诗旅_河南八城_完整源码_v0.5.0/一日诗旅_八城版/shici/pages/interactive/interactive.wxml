<view class="container">
  <view class="card"><view class="title">诗词互动</view><view class="subtitle">游戏化学习 · 诗人对话 · 打卡集章</view></view>
  <view class="card challenge"><view class="section-title">诗词接龙</view>
    <block wx:if="{{!finished}}">
      <view class="question">{{questions[cur].q}}</view>
      <view class="option {{answered ? (index2 === questions[cur].ans ? 'right' : (index2 === picked ? 'wrong' : '')) : ''}}" wx:for="{{questions[cur].opts}}" wx:for-item="opt" wx:for-index="index2" wx:key="index2" bindtap="answer" data-index="{{index2}}">{{opt}}</view>
      <view class="jielong-foot" wx:if="{{answered}}">
        <view class="j-count">答对 {{correct}}/{{total}} · 得分 {{score}}</view>
        <view class="j-next" bindtap="next">{{cur === total - 1 ? '查看结果' : '下一句 ›'}}</view>
      </view>
    </block>
    <view class="q-done" wx:else>
      <view class="d-score">本轮完成 · 答对 {{correct}}/{{total}}</view>
      <view class="d-tip">得分 {{score}} 分</view>
      <view class="j-next" bindtap="build">再来一轮</view>
    </view>
  </view>
  <view class="card"><view class="section-title">AI诗人对话</view><view class="subtitle">选择一位诗人开始体验</view>
    <view class="poets"><view class="poet" bindtap="talk" data-name="杜甫">杜甫</view><view class="poet" bindtap="talk" data-name="李白">李白</view><view class="poet" bindtap="talk" data-name="李商隐">李商隐</view></view>
  </view>
  <view class="card"><view class="section-title">诗词护照</view><view class="badges"><view class="badge" bindtap="goStamp">🏮<text>首站打卡</text></view><view class="badge" bindtap="goQuiz">📜<text>诗句答对</text></view><view class="badge" bindtap="goRoute">🗺️<text>路线探索</text></view></view><view class="ach" bindtap="goPassport">🎫 查看我的护照成就 ›</view></view>
</view>