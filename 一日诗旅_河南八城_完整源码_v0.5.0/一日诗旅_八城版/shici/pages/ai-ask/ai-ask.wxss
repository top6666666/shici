.container{min-height:100vh;display:flex;flex-direction:column;background:#F7F1E3;padding:24rpx;box-sizing:border-box}
.header{display:flex;align-items:center;gap:24rpx;margin-bottom:20rpx}
.avatar{font-size:56rpx;width:96rpx;height:96rpx;background:#F0DFCA;border-radius:50%;text-align:center;line-height:96rpx}
.title{font-size:34rpx;font-weight:700;color:#3A2E28}
.subtitle{font-size:23rpx;color:#8A817A;margin-top:6rpx}
.chat{height:55vh;background:#FFFDF8;border-radius:24rpx;padding:24rpx;margin-bottom:20rpx;box-sizing:border-box}
.msg{display:flex;margin-bottom:22rpx}
.msg.user{justify-content:flex-end}
.bubble{padding:22rpx 26rpx;border-radius:20rpx;font-size:28rpx;line-height:1.6;color:#3A2E28;word-break:break-all;white-space:pre-wrap}
.msg.ai .bubble{background:#F0DFCA;border-top-left-radius:6rpx}
.msg.user .bubble{background:#8C2F39;color:#FFFDF8;border-top-right-radius:6rpx}
.msg.error .bubble{background:#FDECEC;color:#B4232A;border:1rpx dashed #B4232A;border-top-left-radius:6rpx}
.thinking{color:#8A817A;font-style:italic}
.quick{display:flex;flex-wrap:wrap;gap:16rpx;margin-bottom:20rpx}
.quick-item{background:#F0DFCA;color:#6F252E;font-size:24rpx;padding:14rpx 24rpx;border-radius:999rpx}
.inputbar{display:flex;gap:16rpx;align-items:center}
.input{flex:1;background:#FFFDF8;border-radius:20rpx;padding:0 24rpx;font-size:28rpx;box-sizing:border-box;width:0;height:88rpx;line-height:88rpx}
.send{background:#8C2F39;color:#FFFDF8;border-radius:20rpx;padding:0 28rpx;font-size:28rpx;font-weight:700;white-space:nowrap;flex-shrink:0;height:88rpx;line-height:88rpx}

.message-content{max-width:86%;min-width:0}
.session-bar{display:flex;justify-content:space-between;align-items:center;margin-bottom:16rpx;font-size:22rpx;color:#8A817A;gap:12rpx}
.session-bar button{margin:0;flex-shrink:0;font-size:22rpx;color:#6F252E;background:#FFFDF8}
.sources{font-size:22rpx;color:#74685F;padding:12rpx 4rpx;line-height:1.7;word-break:break-all}
.source{color:#8C2F39;padding:6rpx 0}
.retry-note{font-size:22rpx;color:#8A817A;margin-top:8rpx}
.send[disabled]{background:#B9A19D;color:#FFFDF8}
.send::after{border:0}

.travel-action{background:#f0e4cf;color:#71313b;font-size:26rpx;border-radius:12rpx;line-height:76rpx;margin:16rpx 0;text-align:left;padding:0 22rpx;}
