<view class="container">
  <view class="card hero">
    <view class="hero-title">📜 诗句答对</view>
    <view class="subtitle">诗词闯关 · 上句接下句 · 每题10分 · 历史最佳 {{best}} 分</view>
    <view class="bar"><view class="fill" style="width:{{progress}}%"></view></view>
    <view class="progress-text">第 {{cur + 1}} / {{total}} 题 · 当前得分 {{score}}</view>
  </view>

  <block wx:if="{{!finished}}">
    <view class="card q" wx:for="{{questions}}" wx:if="{{index === cur}}" wx:key="index">
      <view class="q-title">{{item.q}}</view>
      <view class="opt {{answered ? (index2 === item.ans ? 'right' : (index2 === picked ? 'wrong' : '')) : ''}}" wx:for="{{item.opts}}" wx:for-item="opt" wx:for-index="index2" wx:key="index2" bindtap="answer" data-index="{{index2}}">{{opt}}</view>
      <view class="note" wx:if="{{answered}}">📖 {{item.note}}</view>
      <view class="btn next" wx:if="{{answered}}" bindtap="next">{{cur === total - 1 ? '查看成绩' : '下一题'}}</view>
    </view>
  </block>

  <view class="card result" wx:else>
    <view class="r-title">🎉 闯关完成</view>
    <view class="r-score">{{correct}} / {{total}} 题答对</view>
    <view class="r-percent">正确率 {{percent}}% · 得分 {{score}} 分</view>
    <view class="r-tip">{{verdict}}</view>
    <view class="btn next" bindtap="restart">再来一轮</view>
  </view>
</view>
