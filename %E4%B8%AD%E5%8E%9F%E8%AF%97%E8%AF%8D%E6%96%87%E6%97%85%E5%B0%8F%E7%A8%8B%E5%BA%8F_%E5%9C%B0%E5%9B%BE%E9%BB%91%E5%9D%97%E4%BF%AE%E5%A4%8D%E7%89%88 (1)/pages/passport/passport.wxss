.container{min-height:100vh;background:#F7F1E3;padding:24rpx;box-sizing:border-box}
.card{background:#FFFDF8;border-radius:24rpx;padding:28rpx;margin-bottom:20rpx}
.hero-title{font-size:36rpx;font-weight:700;color:#3A2E28}
.level{font-size:52rpx;font-weight:700;color:#8C2F39;margin-top:20rpx}
.points{font-size:26rpx;color:#A65B4E;margin-top:10rpx}
.bar{height:18rpx;background:#E9DED0;border-radius:999rpx;margin-top:24rpx;overflow:hidden}
.fill{height:100%;background:linear-gradient(90deg,#A65B4E,#8C2F39);border-radius:999rpx;transition:width .3s}
.bar.small{height:12rpx;margin-top:12rpx}
.progress-text{font-size:22rpx;color:#A65B4E;margin-top:14rpx}
.section-title{font-size:30rpx;font-weight:700;color:#3A2E28;margin:8rpx 4rpx 16rpx}
.p-row{display:flex;justify-content:space-between;font-size:26rpx;color:#3A2E28;margin-bottom:8rpx}
.p-row text:last-child{color:#A65B4E;font-weight:700}
.prog .p-row + .bar{margin-bottom:20rpx}
.badge-grid{display:flex;flex-wrap:wrap;justify-content:space-between}
.medal{width:31%;background:#FFFDF8;border-radius:20rpx;padding:22rpx 10rpx;text-align:center;margin-bottom:18rpx;box-sizing:border-box;border:3rpx solid #E9DED0}
.medal.lit{border-color:#8C2F39;background:#FBF1E7}
.m-icon{font-size:48rpx}
.m-name{font-size:24rpx;font-weight:700;color:#3A2E28;margin-top:10rpx}
.m-desc{font-size:20rpx;color:#8A817A;margin-top:6rpx;line-height:1.5}
.medal:not(.lit) .m-name{color:#B4ACA3}
.entry{display:flex;gap:16rpx;margin-top:8rpx}
.btn{flex:1;text-align:center;padding:24rpx 0;border-radius:999rpx;background:#8C2F39;color:#FFFDF8;font-size:26rpx;font-weight:700}
.foot-tip{font-size:22rpx;color:#A79E94;text-align:center;padding:16rpx 20rpx 30rpx;line-height:1.7}
