# ============================================================
# 中原诗旅智导 · 后端环境变量模板
# 复制本文件为 .env（backend/.env）并填写真实值。
# .env 仅本地使用，已加入 .gitignore，禁止提交到仓库。
# ============================================================

# 【必填】阿里云百炼 API Key
# 获取方式：阿里云百炼控制台 -> API-KEY 管理 -> 创建
# 注意：不要把真实密钥发到聊天或任何公开位置
DASHSCOPE_API_KEY=

# 百炼 OpenAI 兼容接口地址（北京地域默认业务空间）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 【按控制台确认】模型代码：以百炼控制台“模型广场”实际可调用的代码为准
DASHSCOPE_MODEL=qwen3.5-plus-2026-02-15

# 单次请求超时（秒）与输出 Token 上限（控制免费额度消耗，避免无谓调用）
REQUEST_TIMEOUT=30
MAX_TOKENS=800

# 服务监听地址与端口（本地调试用 127.0.0.1）
HOST=127.0.0.1
PORT=8000
