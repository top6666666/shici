.container{min-height:100vh;background:#F7F1E3;padding:24rpx;box-sizing:border-box}
.card{background:#FFFDF8;border-radius:24rpx;padding:28rpx;margin-bottom:20rpx}
.hero-title{font-size:36rpx;font-weight:700;color:#3A2E28}
.subtitle{font-size:24rpx;color:#8A817A;margin-top:10rpx}
.bar{height:18rpx;background:#E9DED0;border-radius:999rpx;margin-top:24rpx;overflow:hidden}
.fill{height:100%;background:linear-gradient(90deg,#A65B4E,#8C2F39);border-radius:999rpx;transition:width .3s}
.bar.small{height:12rpx;margin-top:16rpx}
.progress-text{font-size:22rpx;color:#A65B4E;margin-top:14rpx}
.section-title{font-size:30rpx;font-weight:700;color:#3A2E28;margin:8rpx 4rpx 16rpx}
.route{position:relative}
.route.locked{opacity:.82}
.r-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:12rpx}
.tag{font-size:22rpx;color:#6F252E;background:#F0DFCA;padding:6rpx 20rpx;border-radius:999rpx}
.state{font-size:24rpx;font-weight:700}
.state.open{color:#2F6B3F}
.state.lock{color:#9C3A3A}
.route-name{font-size:32rpx;font-weight:700;color:#3A2E28;line-height:1.4}
.subtitle{font-size:24rpx;color:#8A817A;margin-top:8rpx}
.desc{font-size:23rpx;color:#6B5F56;margin-top:8rpx;line-height:1.6}
.link{font-size:23rpx;color:#A65B4E;margin-top:14rpx}
.foot{margin-top:8rpx}
.btn{text-align:center;padding:26rpx;border-radius:999rpx;background:#8C2F39;color:#FFFDF8;font-size:30rpx;font-weight:700}
.foot-tip{font-size:22rpx;color:#A79E94;text-align:center;padding:16rpx 20rpx 30rpx;line-height:1.7}
