<view class="container">
  <view class="card hero">
    <view class="hero-title">🎫 我的诗词护照</view>
    <view class="level">{{levelName}}</view>
    <view class="points">诗旅积分 · {{points}}</view>
    <view class="bar"><view class="fill" style="width:{{levelProgress}}%"></view></view>
    <view class="progress-text">{{nextName ? ('距「' + nextName + '」还需 ' + nextNeed + ' 分') : '已达最高称号 · 诗仙之魂'}}</view>
  </view>

  <view class="section-title">板块进度</view>
  <view class="card prog">
    <view class="p-row"><text>🏮 首站打卡</text><text>{{stampedCount}} / {{totalPoints}}</text></view>
    <view class="bar small"><view class="fill" style="width:{{stampPct}}%"></view></view>
    <view class="p-row"><text>📜 诗句答对 · 最高分</text><text>{{quizBest}} / 120</text></view>
    <view class="bar small"><view class="fill" style="width:{{quizPct}}%"></view></view>
    <view class="p-row"><text>🗺️ 路线解锁</text><text>{{unlockedRoutes}} / {{totalRoutes}}</text></view>
    <view class="bar small"><view class="fill" style="width:{{routePct}}%"></view></view>
    <view class="p-row"><text>🗺️ 路线完成（点位全点亮）</text><text>{{completedRoutes}} / {{totalRoutes}}</text></view>
    <view class="bar small"><view class="fill" style="width:{{completedRoutePct}}%"></view></view>
  </view>

  <view class="section-title">成就勋章 · {{litCount}}/{{badges.length}}</view>
  <view class="badge-grid">
    <view class="medal {{item.lit ? 'lit' : ''}}" wx:for="{{badges}}" wx:key="id">
      <view class="m-icon">{{item.lit ? item.icon : '🔒'}}</view>
      <view class="m-name">{{item.name}}</view>
      <view class="m-desc">{{item.desc}}</view>
    </view>
  </view>

  <view class="entry">
    <view class="btn" bindtap="goStamp">🏮 首站打卡</view>
    <view class="btn" bindtap="goQuiz">📜 诗句答对</view>
    <view class="btn" bindtap="goRoute">🗺️ 路线探索</view>
  </view>
  <view class="foot-tip">打卡点位、答对诗词、解锁路线都会累计积分并点亮勋章，达成三个板块成就即可成为“诗旅全才”。</view>
</view>
