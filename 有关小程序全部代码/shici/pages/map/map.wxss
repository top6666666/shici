.map-card{background:#fffdf8;border-radius:24rpx;overflow:hidden;margin-bottom:24rpx;border:1rpx solid #e8e1d5}
.map-image{display:block;width:100%}
.map-note{padding:16rpx 22rpx;color:#8b8173;font-size:23rpx;background:#fffdf8}
.small{font-size:30rpx}
.intro{line-height:1.7;margin:18rpx 0;color:#665E58}
.poem-name{font-size:25rpx;color:#8c2f39;margin:12rpx 0 20rpx}
.list-item{display:flex;justify-content:space-between;align-items:center}
.point-main{flex:1}
.name{font-size:28rpx;font-weight:700}
.arrow{font-size:44rpx;color:#8C2F39;margin-left:18rpx}
