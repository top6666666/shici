.guide{display:flex;align-items:center;gap:24rpx;background:#fffdf8;border:1rpx solid #e9ddcb;border-radius:24rpx;padding:24rpx;margin:0 0 24rpx;box-sizing:border-box;color:#3a2e28}.copy{flex:1;min-width:0}.heading{font-size:29rpx;font-weight:600;line-height:1.5}.message{font-size:24rpx;color:#776a5e;line-height:1.7;margin-top:8rpx}.meet{padding:8rpx 0 0;margin:0;background:transparent;font-size:22rpx;color:#8c2f39;text-align:left;line-height:1.8}.meet::after{border:0}.compact{padding:16rpx;margin-bottom:16rpx;gap:16rpx}.compact .heading{font-size:25rpx}.compact .message{font-size:22rpx}.compact .meet{display:none}