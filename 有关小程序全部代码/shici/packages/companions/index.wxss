.page{padding:28rpx;background:#f7f1e3;min-height:100vh;box-sizing:border-box;color:#3a2e28}.title{font-size:34rpx;font-weight:700;line-height:1.5}.intro{font-size:23rpx;color:#827364;margin:12rpx 0 28rpx}.person{display:flex;gap:24rpx;align-items:center;padding:26rpx;border:1rpx solid #e9ddcb;background:#fffdf8;border-radius:24rpx;margin:20rpx 0}.info{flex:1;min-width:0}.name{font-size:32rpx;font-weight:600}.role{font-size:24rpx;color:#8c2f39;margin:10rpx 0}.desc,.note{font-size:24rpx;line-height:1.8;color:#776a5e}.small{font-size:29rpx;margin:32rpx 0 16rpx}.design{width:100%;display:block;border-radius:20rpx}.note{margin:20rpx 0}.go{background:#8c2f39;color:#fffdf8;text-align:center;padding:24rpx;border-radius:16rpx;font-size:28rpx}