<view class="container">
  <view class="card">
    <view class="title">中原诗词地图</view>
    <view class="subtitle">诗人 · 诗作 · 地点 · 历史 · 文化价值</view>
  </view>

  <!-- 使用本地地图插画，避免原生地图瓦片加载异常出现黑块 -->
  <view class="map-card">
    <image class="map-image" src="/assets/central-plains-poetry-map.png" mode="widthFix" />
    <view class="map-note">示意地图｜选择下方文化点位查看详情</view>
  </view>

  <view class="card point" wx:if="{{selected}}">
    <view class="title small">{{selected.name}}</view>
    <view class="tag">{{selected.city}}</view>
    <view class="tag">{{selected.poet}}</view>
    <view class="intro">{{selected.intro}}</view>
    <view class="poem-name">关联诗词：{{selected.poem}}</view>
    <view class="btn" bindtap="listen">一键听诗</view>
  </view>

  <view class="section-title">文化点位</view>
  <view class="card list-item" wx:for="{{points}}" wx:key="id" bindtap="selectPoint" data-id="{{item.id}}">
    <view class="point-main">
      <view class="name">{{item.name}}</view>
      <view class="subtitle">{{item.city}} · {{item.poem}}</view>
    </view>
    <view class="arrow">›</view>
  </view>
</view>
