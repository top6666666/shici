<view class="container">
  <view class="header card">
    <view class="avatar">🤖</view>
    <view>
      <view class="title">AI 问诗助手</view>
      <view class="subtitle">诗句 · 诗人 · 典故 · 河南诗旅</view>
    </view>
  </view>

  <scroll-view class="chat" scroll-y scroll-into-view="{{toView}}" scroll-with-animation>
    <view class="msg {{item.role}}" wx:for="{{messages}}" wx:key="index" id="msg-{{index}}">
      <view class="bubble {{item.role==='error' ? 'err-bubble' : ''}}" bindtap="{{item.role==='error' ? 'retry' : ''}}" data-text="{{item.failText}}">{{item.text}}</view>
    </view>
    <view class="msg ai" wx:if="{{loading}}">
      <view class="bubble thinking">正在思考...</view>
    </view>
  </scroll-view>

  <view class="quick">
    <view class="quick-item" wx:for="{{quick}}" wx:key="*this" bindtap="quickTap" data-q="{{item}}">{{item}}</view>
  </view>

  <view class="inputbar">
    <input class="input" value="{{input}}" bindinput="onInput" bindconfirm="send" confirm-type="send" placeholder="输入你的诗词问题..." />
    <view class="send" bindtap="send">发送</view>
  </view>
</view>
